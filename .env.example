DISCORD_TOKEN=
# Optional Twitch/YouTube stream link for Meyaya's Streaming presence rotation.
PRESENCE_STREAM_URL=
# For 512 MB hosting use 25 / false; defaults preserve local behavior.
DISCORD_MESSAGE_CACHE_SIZE=100
DISCORD_CHUNK_ON_STARTUP=true
DATABASE_URL=postgresql+asyncpg://meyaya_user:change-me@localhost:5432/meyaya
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
REDIS_TLS_VERIFY=true
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Optional HTTPS origin for owner login links when hosted remotely.
DASHBOARD_PUBLIC_URL=
# Remote HTTPS proxy IPs or CIDRs, comma-separated. Never use 0.0.0.0/0.
DASHBOARD_TRUSTED_PROXIES=
DASHBOARD_TOKEN=
QUOTA_EXEMPT_GUILD_ID=1479860234183905443
KLIPY_API_KEY=
KLIPY_RATING=g
LOG_LEVEL=INFO
GUILD_ID=
COURT_CHANNEL_ID=
GEMINI_API_KEY=your-key-here
LLM_PROVIDER=gemini
# Resource protection and member cooldown; the original server chat quota is unchanged.
AI_ENABLED=true
AI_MAX_CONCURRENT=2
AI_QUEUE_SIZE=4
AI_QUEUE_WAIT_SECONDS=6
AI_USER_COOLDOWN_SECONDS=5
# Group rapid messages from the same member/channel into one AI turn.
CHAT_BATCH_DELAY_SECONDS=0.75
CHAT_BATCH_MAX_WAIT_SECONDS=2
AI_MAX_INPUT_CHARS=32000
AI_MAX_OUTPUT_TOKENS=2048
VOICE_MAX_SESSIONS=1
VOICE_SESSION_MINUTES=10
# Empty uses the existing alternate route; set a model to override it.
GEMINI_FALLBACK_MODEL=
# Match these to YOUR project's AI Studio limits. Counts attempts, not replies.
# Same-project keys/processes should share this namespace and Redis database.
GEMINI_QUOTA_NAMESPACE=meyaya
GEMINI_PACING_WAIT_SECONDS=6
GEMINI_MODEL_LIMITS={"gemini-3.5-flash-lite":{"rpm":15,"rpd":500},"gemini-3.5-flash":{"rpm":5,"rpd":20},"gemini-2.5-flash":{"rpm":5,"rpd":20}}
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.5-flash
GEMINI_GROUNDED_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Leda
JUNGKOOK_ROLEPLAY_AVATAR_URL=
ALYA_ROLEPLAY_AVATAR_URL=
GEMINI_LIVE_SYSTEM_INSTRUCTION=You are Meyaya in a Discord voice chat. Speak naturally, concise, playful, and avoid markdown.
# Optional audio decoding executable (music generation is archived).
FFMPEG_EXECUTABLE=ffmpeg
